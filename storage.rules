rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAllowedDocument() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }

    match /users/{userId}/documents/{investmentId}/{fileId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && resource == null && isAllowedDocument();
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/backups/{backupFile} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
